# Kiali : dashboard du mesh Istio. Lecture seule, branché sur le Prometheus de
# la stack observability (kube-prometheus-stack) déjà déployée — pas de
# Prometheus dédié à monter. L'accès se fait via port-forward / tunnel (pas
# d'exposition publique : zero-trust réseau conservé, cf. accès Grafana/ArgoCD).
auth:
  strategy: anonymous

deployment:
  view_only_mode: false

external_services:
  istio:
    root_namespace: {{ istio_namespace }}
  prometheus:
    # Service Prometheus de kube-prometheus-stack dans le namespace monitoring.
    url: "http://kube-prometheus-stack-prometheus.{{ monitoring_namespace }}.svc.cluster.local:9090"
  # Branche Grafana pour que Kiali connaisse sa version et propose les liens
  # « View in Grafana » vers les dashboards Istio (corrige le « unknown »).
  grafana:
    enabled: true
    internal_url: "http://kube-prometheus-stack-grafana.{{ monitoring_namespace }}.svc.cluster.local"
