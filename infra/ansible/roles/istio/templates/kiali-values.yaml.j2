# Kiali : dashboard du mesh Istio. Branché sur le Prometheus/Grafana de la stack
# observability (kube-prometheus-stack) déjà déployée — pas de Prometheus dédié.
# Exposé via le Cloudflare Tunnel (kiali.sylvainrougie.fr, protégé par Access) :
# aucun port entrant, zero-trust réseau conservé (cf. Grafana/ArgoCD).
auth:
  # L'authentification est assurée EN AMONT par Cloudflare Access (login OTP).
  # Kiali lui-même est en anonymous : la porte est devant, dans Cloudflare.
  strategy: anonymous

deployment:
  view_only_mode: false

server:
  # Kiali rejette par défaut tout Host autre que localhost (anti-DNS-rebinding).
  # Derrière le tunnel, les requêtes arrivent avec Host=kiali.sylvainrougie.fr :
  # on déclare ce FQDN comme web_fqdn et on désactive l'enforced-host, sinon
  # Kiali renvoie une erreur 4xx pour ce hostname.
  web_fqdn: "{{ kiali_hostname }}"
  web_schema: "https"

external_services:
  istio:
    root_namespace: {{ istio_namespace }}
  prometheus:
    # Service Prometheus de kube-prometheus-stack dans le namespace monitoring.
    url: "http://kube-prometheus-stack-prometheus.{{ monitoring_namespace }}.svc.cluster.local:9090"
  # Branche Grafana pour que Kiali connaisse sa version et propose les liens
  # « View in Grafana » vers les dashboards Istio (corrige le « unknown »).
  grafana:
    enabled: true
    internal_url: "http://kube-prometheus-stack-grafana.{{ monitoring_namespace }}.svc.cluster.local"
    external_url: "https://{{ grafana_hostname }}"
