{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "SPIRE / Zero-trust",
  "tags": ["spire", "zero-trust", "shop"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Décisions d'autorisation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Décisions allowed / denied par service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service, decision) (rate(authz_decisions_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{ '{{service}}' }} - {{ '{{decision}}' }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Refus (denied) - 5 min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(authz_decisions_total{decision=\"denied\", service=~\"$service\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Trafic HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Requêtes HTTP par service / route",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (service, path) (rate(http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{ '{{service}}' }} {{ '{{path}}' }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Statuts HTTP par code",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (code) (rate(http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{ '{{code}}' }}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "SPIRE",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "stat",
      "title": "Cibles UP (shop)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(up{job=\"shop-services\"})", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "SVID X.509 émis (taux)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spire_server_svid_signed_total[5m])) or sum(rate(spire_agent_manager_svid_rotate[5m]))",
          "legendFormat": "SVID signés/rotés",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Analytics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Analytics — événements (via Envoy)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(analytics_events_total[5m]))",
          "legendFormat": "événements/s",
          "refId": "A"
        },
        {
          "expr": "sum by (caller) (rate(analytics_events_by_caller_total[5m]))",
          "legendFormat": "{{ '{{caller}}' }}",
          "refId": "B"
        }
      ]
    }
  ]
}
