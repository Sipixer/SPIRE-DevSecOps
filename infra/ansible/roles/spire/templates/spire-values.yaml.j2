global:
  spire:
    trustDomain: "{{ spire_trust_domain }}"
    clusterName: "{{ spire_cluster_name }}"
    # Désactive le strictMode qui exige des valeurs "production".
    recommendations:
      enabled: false

spire-server:
  telemetry:
    prometheus:
      enabled: true

spire-agent:
  # SDS désactivé par défaut dans le chart. Sans ça l'agent ne résout pas les
  # noms de secrets demandés par Envoy ("workload is not authorized...").
  sds:
    enabled: true
    defaultSVIDName: "default"
    defaultBundleName: "ROOTCA"
    defaultAllBundlesName: "ALL"
  telemetry:
    prometheus:
      enabled: true
      port: 9988
      host: "0.0.0.0"
