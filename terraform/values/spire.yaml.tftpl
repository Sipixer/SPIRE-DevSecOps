# Valeurs du chart spiffe/spire (helm-charts-hardened).
# On surcharge le strict minimum ; les défauts du chart sont déjà hardened
# et suffisent pour un cluster k3d de démo (attestation PSAT, controller manager).

global:
  spire:
    trustDomain: "${trust_domain}"
    clusterName: "spire"
    # Désactive le strictMode qui exige des valeurs "production" (TLS upstream, etc.).
    recommendations:
      enabled: false
